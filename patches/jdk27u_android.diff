+static ifaddrs_storage* new_ifaddrs_storage(ifaddrs** list) {
+  ifaddrs_storage *storage = (ifaddrs_storage*) calloc(1, sizeof(ifaddrs_storage));
+  if (storage == nullptr) return nullptr;
+  // push_front onto `list`.
+  storage->ifa.ifa_next = *list;
+  *list = reinterpret_cast<ifaddrs*>(storage);
+  return storage;
